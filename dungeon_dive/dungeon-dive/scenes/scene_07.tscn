[node name="ScoringNotesLabel" type="Label" parent="ScrollContainer/RulesContainer" unique_id=95479141]
custom_maximum_size = Vector2(1192, -1)
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "Pairs, two pair, three and four of a kind score as soon as their cards are placed. Straights and flushes need all five cards in the line.

Each line scores points x mult. Rewards add points or mult to hands of a Pair or better, and each wave's boss can take them away. While playing, click Scoring (or a row or column score) to open the scoring panel with this table. Hover the score at the end of a row or column to see that line as points x mult."
autowrap_mode = 3

